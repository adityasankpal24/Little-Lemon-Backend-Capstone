# Copy this file to .env and update the database credentials.
# To use MySQL, keep DB_ENGINE=mysql and provide a database/user/password.
DB_ENGINE=mysql
DB_NAME=littlelemon
DB_USER=root
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Replace this with a long random value before deployment.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
